# 이 파일을 복사해 같은 폴더에 .env를 만든다 (.env는 커밋하지 않는다)
#   cp .env.example .env   (Windows: copy .env.example .env)
# docker compose와 백엔드(application.yml)가 함께 읽는다.

# PostgreSQL (compose.yaml이 이 값으로 DB를 만든다. 비밀번호는 아무 값이나 정해서 채운다)
DB_NAME=trendizm
DB_USERNAME=trendizm
DB_PASSWORD=
DB_PORT=5433

# Redis
REDIS_PORT=6379

# JWT 서명 키: 32자 이상 임의 문자열 (3.3 로그인부터 필수). 팀원끼리 같은 값을 쓸 필요는 없다
JWT_SECRET=
